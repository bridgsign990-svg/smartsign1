# Template only: BridgeSign does not automatically load .env files.
# Set these in your shell or hosting dashboard. Commented values show the
# defaults used when a variable is not set.

# ── Required in production ────────────────────────────────────────────
# Production is detected from RENDER, RAILWAY_ENVIRONMENT, or
# FLASK_ENV/APP_ENV/ENVIRONMENT=production; startup fails there without it.
# Generate a value with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-generated-secret

# ── Server and storage ────────────────────────────────────────────────
# PORT=5000
# BRIDGESIGN_HOST=127.0.0.1             # use 0.0.0.0 to accept other devices on the network
# BRIDGESIGN_DATA_DIR=./data            # SQLite database and user data
# DATABASE_URL=                         # PostgreSQL URL; SQLite in BRIDGESIGN_DATA_DIR when unset
# BRIDGESIGN_PUBLIC_URL=                # external base URL used in call invitation links

# ── Live recognition ──────────────────────────────────────────────────
# BRIDGESIGN_LIVE_GESTURES=1                     # 0 disables the motion-gesture (word, J/Z) model
# BRIDGESIGN_MIN_CONFIRMED_STATIC_CONFIDENCE=0.8 # letter must reach this confidence to commit
# BRIDGESIGN_CONSECUTIVE_THRESHOLD=5             # same-letter frames needed to commit
# BRIDGESIGN_STATIC_STEADY_MAX_MOTION=1.5        # hand must be this still for a letter
# BRIDGESIGN_GESTURE_MOTION_THRESHOLD=1.5        # motion needed before the gesture model runs
# BRIDGESIGN_GESTURE_CONFIRM_FRAMES=3            # frames needed to commit a gesture
# BRIDGESIGN_WARM_INFERENCE=1                    # load models at startup instead of first request
# BRIDGESIGN_DEBUG_TOPK=0                        # 1 adds top-5 letter probabilities to responses

# ── Performance tuning ────────────────────────────────────────────────
# BRIDGESIGN_INFER_EVERY_N_FRAMES=2
# BRIDGESIGN_LIVE_CLIENT_MAX_DIM=320
# BRIDGESIGN_LIVE_FRAME_SKIP=1
# BRIDGESIGN_CLASSIFIER_CACHE_SIZE=2048
# BRIDGESIGN_CLASSIFIER_CACHE_DECIMALS=2
# BRIDGESIGN_IMAGE_MAX_DIM=768
# BRIDGESIGN_IMAGE_MAX_UPLOAD_BYTES=15728640
# BRIDGESIGN_IMAGE_CACHE_SIZE=64
# BRIDGESIGN_STT_CACHE_SIZE=128
# BRIDGESIGN_PERF_LOG_EVERY_N=60

# ── Calls ─────────────────────────────────────────────────────────────
# BRIDGESIGN_CALL_INVITE_TTL_SECONDS=86400
# BRIDGESIGN_TURN_ICE_SERVERS=          # JSON list of TURN/STUN servers for calls across networks

# ── Experimental uploaded-video recognition (see video_recognition.py) ─
# BRIDGESIGN_VIDEO_RECOGNITION_PYTHON=
# BRIDGESIGN_OPENHANDS_SOURCE_DIR=
# BRIDGESIGN_VIDEO_RECOGNITION_MAX_UPLOAD_BYTES=
# BRIDGESIGN_VIDEO_RECOGNITION_TIMEOUT_SECONDS=
# BRIDGESIGN_VIDEO_RECOGNITION_MAX_SECONDS=
